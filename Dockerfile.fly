FROM python:3.11-slim

WORKDIR /app

# Minimal system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (CPU-only torch to keep image small)
COPY requirements.fly.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy engine source
COPY engine/src/ ./engine/src/
COPY engine/src/__init__.py ./engine/__init__.py

# Copy UI standalone (the main app)
COPY orion-ui-standalone/ ./app/

# Symlink engine src into app so imports work: from src.xxx import yyy
RUN ln -sf /app/engine/src /app/app/src

# Stage bundled uploads so boot.sh can sync new avatars on every deploy
# (the live uploads dir gets symlinked to persistent storage)
RUN cp -a /app/app/data/uploads /app/_bundled_uploads

# Stage bundled memory vault so seeded memories survive across deploys
RUN cp -a /app/app/data/memory /app/_bundled_memory

# Stage bundled config so settings persist across deploys
RUN cp -a /app/app/config /app/_bundled_config

# Copy boot script
COPY boot.sh /app/boot.sh
RUN chmod +x /app/boot.sh

WORKDIR /app/app

# Expose the port
EXPOSE 8989

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8989/api/auth/config || exit 1

# Run via boot script (sets up persistent uploads, then starts uvicorn)
CMD ["/app/boot.sh"]
