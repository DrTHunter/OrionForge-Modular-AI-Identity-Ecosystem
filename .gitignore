# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Runtime data (keep structure via .gitkeep but not actual data)
# data/chats: ignore live runtime chats but KEEP the bundled seed conversations
orion-ui-standalone/data/chats/*
!orion-ui-standalone/data/chats/seed/
# data/memory: ignore the live vault + generated faiss index but KEEP the seed vault
orion-ui-standalone/data/memory/*
!orion-ui-standalone/data/memory/seed_vault.jsonl
orion-ui-standalone/data/shared/
orion-ui-standalone/data/trash/
# data/uploads: ignore user-uploaded runtime files, but KEEP the shipped default
# agent avatars + chat background so a fresh deploy has them out of the box.
orion-ui-standalone/data/uploads/*
!orion-ui-standalone/data/uploads/avatar_*
!orion-ui-standalone/data/uploads/chat_bg.*
orion-ui-standalone/data/user_notes/
orion-ui-standalone/data/users/
orion-ui-standalone/data/orion/*.jsonl
orion-ui-standalone/data/orion/*.json
# MCP server runtime state (per-user default agent, soul-script index)
orion-ui-standalone/data/mcp_*

# Secrets & credentials
*.env
.webui_secret_key
fly_deploy.log
_patch_*.py
_validate_*.py

# Personal notes that may contain secrets. This file normally lives OUTSIDE the
# repo; this is a defensive net so a copy can never be committed if moved inside.
OF Notes.txt
**/OF Notes.txt

# Runtime config with personal data / billing state — use *.example.json as templates
**/config/auth.json
**/config/stripe_state.json
**/config/connections.json
**/config/vscode_bridge.json

# Encrypted per-user API key files
**/*.enc.json

# Sentence-transformers cache
.cache/

# Backup files
*.old
*.bak

# OG card render tooling (not for deployment)
website/images/node_modules/
website/images/package.json
website/images/package-lock.json
website/images/render-og.js

# Test output artifacts
**/torture_result.txt
**/test_torture_output.txt
**/test_torture_out.txt
**/torture_run*.txt
**/verify.txt
**/fails_only.txt
test_output.txt
